{
  "name": "@fee-split-vaults/catalog",
  "version": "0.1.0",
  "private": true,
  "description": "The vendor catalog, rate card and screening seed data, with the two-price-book accounting invariants enforced in code.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "seal": "tsc --build && node dist/scripts/seal-data.js",
    "verify": "tsc --build && node dist/scripts/verify-data.js",
    "fetch:ofac": "tsc --build && node dist/scripts/fetch-ofac.js"
  },
  "dependencies": {
    "@fee-split-vaults/broker": "*",
    "@fee-split-vaults/core": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
