{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/__tests__/**"],
  "references": [
    { "path": "../../config" },
    { "path": "../core" },
    { "path": "../ledger" },
    { "path": "../indexer" },
    { "path": "../broker" },
    { "path": "../runtime" },
    { "path": "../publisher" }
  ]
}
