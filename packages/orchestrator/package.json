{
  "name": "@fee-split-vaults/orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "The per-coin tick loop: indexer -> ledger -> tier -> runtime -> broker -> publisher -> receipts, on a fixed schedule, with per-coin isolation.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fee-split-vaults/broker": "*",
    "@fee-split-vaults/core": "*",
    "@fee-split-vaults/indexer": "*",
    "@fee-split-vaults/ledger": "*",
    "@fee-split-vaults/publisher": "*",
    "@fee-split-vaults/runtime": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
