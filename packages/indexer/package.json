{
  "name": "@fee-split-vaults/indexer",
  "version": "0.1.0",
  "private": true,
  "description": "Chain ingestion and QF measurement for chain 4663. Bounded watch set, hash-pinned two-provider quorum reads, per-coin fee attribution.",
  "type": "module",
  "main": "dist/index.js",
