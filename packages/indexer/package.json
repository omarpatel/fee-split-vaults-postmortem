    "typecheck": "tsc --build --force",
    "test": "vitest run"
  },
  "dependencies": {
    "@fee-split-vaults/core": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
